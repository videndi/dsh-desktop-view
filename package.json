{
  "name": "dsh-desktop-view",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop observation and input tools for the DeepSeek Harness agent: DPI-aware screen capture, pointer position, monitor layout and window titles, plus move, click, drag, scroll, type, key and window control on Windows.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "scripts/capture.ps1",
    "scripts/control.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/scene.js && node --check lib/control.js && node --check lib/powershell.js",
    "test": "node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "desktop",
    "screenshot",
    "screen-capture",
    "cursor",
    "mouse",
    "keyboard",
    "automation",
    "windows",
    "agent"
  ],
  "license": "MIT",
  "author": "Gaoler006115",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaoler006115/dsh-desktop-view.git"
  },
  "homepage": "https://github.com/Gaoler006115/dsh-desktop-view#readme",
  "bugs": {
    "url": "https://github.com/Gaoler006115/dsh-desktop-view/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
